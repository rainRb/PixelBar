<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PixelBar_App.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PixelBar_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="{StaticResource AppContentMaxWidth}"
            Padding="{StaticResource AppPagePadding}"
            HorizontalAlignment="Center">
            <StackPanel Spacing="{StaticResource AppSectionSpacing}">
                <controls:PageHeader
                    x:Name="PageHeaderControl"
                    Subtitle="在 PixelBar 像素屏上同步显示音乐播放器歌词。使用前请关闭 TempoHub，并在设置中连接设备。"
                    Title="动态歌词" />

                <InfoBar
                    x:Name="StatusBar"
                    IsOpen="False"
                    IsClosable="True" />

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="音乐播放器" />
                        <RadioButtons
                            x:Name="ProviderGroup"
                            MaxColumns="2"
                            SelectionChanged="ProviderGroup_SelectionChanged">
                            <RadioButton Content="QQ 音乐" IsChecked="True" Tag="qq" />
                            <RadioButton Content="网易云音乐" Tag="netease" />
                        </RadioButtons>
                        <TextBlock
                            x:Name="ProviderHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="InfLinkPanel" Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="InfLink-rs（必需）" />
                        <TextBlock
                            x:Name="InfLinkStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="网易云 PC 版无法提供可靠播放进度，必须使用 apoint123/InfLink-rs（BetterNCM 插件）。安装后重启网易云。"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="InstallInfLinkButton"
                                Click="InstallInfLinkButton_Click"
                                Content="一键安装 InfLink-rs"
                                HorizontalAlignment="Left" />
                            <HyperlinkButton
                                Click="OpenInfLinkWikiButton_Click"
                                Content="手动安装说明"
                                FontSize="12"
                                Padding="0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="使用引导" />
                            <HyperlinkButton
                                Click="OpenWikiButton_Click"
                                Content="查看 Wiki 详细说明"
                                FontSize="12"
                                Padding="0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="GuidePanel" Spacing="14" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="推送设置" />
                        <ToggleSwitch
                            x:Name="EnableSwitch"
                            Header="启用歌词推送"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="EnableSwitch_Toggled" />
                        <TextBlock
                            x:Name="EnableHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ResyncButton"
                            Click="ResyncButton_Click"
                            Content="重新同步"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding ElementName=EnableSwitch, Path=IsOn}" />
                        <ToggleSwitch
                            x:Name="ScrollSwitch"
                            Header="长句滚动显示"
                            IsEnabled="{Binding ElementName=EnableSwitch, Path=IsOn}"
                            OffContent="居中静态"
                            OnContent="超出长度时滚动"
                            Toggled="ScrollSwitch_Toggled" />
                        <StackPanel x:Name="ScrollDirectionPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="滚动方向" />
                            <RadioButtons
                                x:Name="ScrollDirectionGroup"
                                IsEnabled="{Binding ElementName=EnableSwitch, Path=IsOn}"
                                MaxColumns="2"
                                SelectionChanged="ScrollDirectionGroup_SelectionChanged">
                                <RadioButton Content="左 → 右" IsChecked="True" Tag="ltr" />
                                <RadioButton Content="右 → 左" Tag="rtl" />
                            </RadioButtons>
                        </StackPanel>
                        <NumberBox
                            x:Name="TimingOffsetBox"
                            Header="歌词时间偏移（毫秒）"
                            IsEnabled="{Binding ElementName=EnableSwitch, Path=IsOn}"
                            LargeChange="500"
                            Maximum="30000"
                            Minimum="-30000"
                            SmallChange="50"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="TimingOffsetBox_ValueChanged" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="在歌词文件时间轴上微调：正数早一些，负数晚一些。若仍偏慢可试 +200～1000。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardAccentStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Background="{StaticResource PbAccentBrush}"
                            CornerRadius="14,0,0,14" />
                        <StackPanel
                            Grid.Column="1"
                            Padding="20,18"
                            Spacing="12">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="运行状态" />
                            <TextBlock
                                x:Name="StateText"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="未启用"
                                TextWrapping="Wrap" />
                            <Border Style="{StaticResource LiveStatusCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="SongText"
                                        FontWeight="SemiBold"
                                        Text="—"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="LineText"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        LineHeight="28"
                                        Text="—"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SourceText"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="来源：—" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="DiagnosticText"
                                Style="{StaticResource MonoCaptionStyle}"
                                Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Header="高级选项" IsExpanded="False">
                    <StackPanel Spacing="12" Padding="0,8,0,0">
                        <TextBlock
                            x:Name="AdvancedHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="LyricDirBox"
                            Header="歌词缓存目录"
                            PlaceholderText="留空则使用默认路径"
                            TextChanged="LyricDirBox_TextChanged" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
