<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette (ui-ux-pro-max: dark audio + play green) -->
    <Color x:Key="PbPrimaryColor">#FF1E1B4B</Color>
    <Color x:Key="PbSecondaryColor">#FF4338CA</Color>
    <Color x:Key="PbAccentColor">#FF22C55E</Color>
    <Color x:Key="PbAccentDarkColor">#FF16A34A</Color>
    <Color x:Key="PbBackgroundColor">#FF0F0F23</Color>
    <Color x:Key="PbForegroundColor">#FFF8FAFC</Color>
    <Color x:Key="PbMutedColor">#FF27273B</Color>
    <Color x:Key="PbBorderColor">#FF312E81</Color>
    <Color x:Key="PbConnectedColor">#FF22C55E</Color>
    <Color x:Key="PbDisconnectedColor">#FFEF4444</Color>

    <SolidColorBrush x:Key="PbAccentBrush" Color="{StaticResource PbAccentColor}" />
    <SolidColorBrush x:Key="PbAccentDarkBrush" Color="{StaticResource PbAccentDarkColor}" />
    <SolidColorBrush x:Key="PbPrimaryBrush" Color="{StaticResource PbPrimaryColor}" />
    <SolidColorBrush x:Key="PbSecondaryBrush" Color="{StaticResource PbSecondaryColor}" />
    <SolidColorBrush x:Key="PbMutedBrush" Color="{StaticResource PbMutedColor}" />
    <SolidColorBrush x:Key="PbBorderBrush" Color="{StaticResource PbBorderColor}" />
    <SolidColorBrush x:Key="PbConnectedBrush" Color="{StaticResource PbConnectedColor}" />
    <SolidColorBrush x:Key="PbDisconnectedBrush" Color="{StaticResource PbDisconnectedColor}" />

    <!-- WinUI accent override -->
    <Color x:Key="SystemAccentColor">#FF22C55E</Color>
    <Color x:Key="SystemAccentColorLight1">#FF4ADE80</Color>
    <Color x:Key="SystemAccentColorLight2">#FF86EFAC</Color>
    <Color x:Key="SystemAccentColorLight3">#FFBBF7D0</Color>
    <Color x:Key="SystemAccentColorDark1">#FF16A34A</Color>
    <Color x:Key="SystemAccentColorDark2">#FF15803D</Color>
    <Color x:Key="SystemAccentColorDark3">#FF166534</Color>

    <!-- Layout tokens -->
    <x:Double x:Key="AppContentMaxWidth">920</x:Double>
    <Thickness x:Key="AppPagePadding">32,24,32,48</Thickness>
    <Thickness x:Key="SectionCardPadding">20,18</Thickness>
    <CornerRadius x:Key="SectionCardRadius">14</CornerRadius>
    <x:Double x:Key="AppSectionSpacing">24</x:Double>

    <!-- Typography -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="MonoCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Cards -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SectionCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource SectionCardPadding}" />
    </Style>

    <Style x:Key="SectionCardAccentStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="CornerRadius" Value="{StaticResource SectionCardRadius}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SceneCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="LiveStatusCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="ConnectionBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="StepBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource PbAccentBrush}" />
    </Style>

    <Style x:Key="StepBadgeSecondaryStyle" TargetType="Border" BasedOn="{StaticResource StepBadgeStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryActionButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Navigation -->
    <Style x:Key="NavBrandTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <Style x:Key="NavBrandSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
